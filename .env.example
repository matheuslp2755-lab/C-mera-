# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA compartilhe o arquivo .env preenchido com ninguém.

# URL RTSP da câmera (encontrada nas configurações avançadas do app iCSee)
RTSP_URL=rtsp://usuario:senha@192.168.0.100:554/stream1

# Chave gratuita do imgbb.com (usada para hospedar temporariamente o snapshot,
# necessário porque o WhatsApp/Twilio exige uma URL pública da imagem)
IMGBB_API_KEY=sua_chave_imgbb

# Credenciais da Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=seu_account_sid
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+55SEUNUMEROCOMDDD

# Ajustes opcionais de sensibilidade
MIN_AREA=2000
COOLDOWN_SECONDS=60
